<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <ApplicationIcon>Resources\tray.ico</ApplicationIcon>
    <AssemblyName>ImageClipboardModify</AssemblyName>
    <RootNamespace>ImageClipboardModify</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ImageClipboardModify Contributors</Authors>
    <Description>Clipboard image viewer with one-click copy and save</Description>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
